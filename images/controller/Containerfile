# The controller image (ADR-0009, ADR-0012): one static binary, nothing else. No shell, no
# package manager. Build from the repository root:
#
#   podman build -f images/controller/Containerfile -t faubourg-controller .
#
# Base images are pinned by digest; Dependabot moves them.

FROM docker.io/library/rust:1-alpine@sha256:2c83bf1a38975801abfd05e92387242ab4d5f96fe05131e2a279f3009ad16393 AS build
# Use the image's toolchain, not rust-toolchain.toml's channel, so the build downloads nothing.
ENV RUSTUP_TOOLCHAIN=1.99.1 CARGO_TERM_COLOR=never
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY . .
# The registry and target/ are cache mounts: a rebuild compiles only what changed, and the
# two images share their dependencies. Neither is in the image, and a fresh cache (as in a
# release build) compiles everything, exactly as without them.
# PROFILE is `release` for every shipped image; the integration tests pass `image-test`
# (Cargo.toml), the same code without link-time optimization. Anything else is refused.
ARG PROFILE=release
RUN --mount=type=cache,id=faubourg-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=faubourg-target,target=/src/target,sharing=locked \
    case "$PROFILE" in release|image-test) ;; *) echo "PROFILE must be release or image-test" >&2; exit 1 ;; esac \
 && cargo build --locked --profile "$PROFILE" -p faubourg-controller --bin faubourg-controller \
 && install -m 0555 "target/$PROFILE/faubourg-controller" /faubourg-controller

FROM scratch
COPY --from=build /faubourg-controller /faubourg-controller
USER 65532:65532
ENTRYPOINT ["/faubourg-controller"]
